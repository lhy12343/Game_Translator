<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GameTranslator.Gui</RootNamespace>
    <AssemblyName>GameTranslator</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' == 'Debug'">GameTranslatorDebug</AssemblyName>
    <!-- NuGet / GitHub Packages 元数据 -->
    <PackageId>GameTranslator</PackageId>
    <Version>0.1.0</Version>
    <Authors>lhy12343</Authors>
    <Description>面向 Windows Unity 单机游戏的实时翻译工具</Description>
    <RepositoryUrl>https://github.com/lhy12343/Game_Translator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../xunity-batch/CustomTranslate.dll" LogicalName="CustomTranslate.dll" />
    <InternalsVisibleTo Include="RuntimeChecks" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>
</Project>
