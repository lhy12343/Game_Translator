<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameTranslator.Gui.ViewModels"
             x:Class="GameTranslator.Gui.Views.GlossaryPage"
             Padding="32,24">

    <Design.DataContext>
        <vm:GlossaryPageViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="术语管理" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="维护人名、地名等术语的翻译一致性" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 添加术语 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="添加术语" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Grid ColumnDefinitions="*,*,Auto,Auto" Margin="0">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                        <TextBlock Text="原文" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding NewSource}" Watermark="サクラ"
                                 Background="{StaticResource BgTertiaryBrush}" BorderThickness="1"
                                 BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="6" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                        <TextBlock Text="译文" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding NewTarget}" Watermark="樱花"
                                 Background="{StaticResource BgTertiaryBrush}" BorderThickness="1"
                                 BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="6" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Bottom">
                        <ComboBox SelectedItem="{Binding NewCategory}" MinWidth="100"
                                  Background="{StaticResource BgTertiaryBrush}">
                            <ComboBoxItem Content="通用"/>
                            <ComboBoxItem Content="角色名"/>
                            <ComboBoxItem Content="地名"/>
                            <ComboBoxItem Content="物品"/>
                            <ComboBoxItem Content="技能"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="3" Content="➕ 添加" Command="{Binding AddEntryCommand}"
                            Background="{StaticResource AccentPrimaryBrush}" Foreground="White"
                            BorderThickness="0" CornerRadius="6" Padding="16,8"
                            VerticalAlignment="Bottom" FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 术语列表 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="4">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="2*,2*,1.5*,Auto" Margin="12,10,12,6">
                    <TextBlock Text="原文" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="译文" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="分类" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="操作" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,2*,1.5*,Auto" Margin="12,8,12,8">
                                <TextBlock Text="{Binding Source}" FontSize="13"
                                           Foreground="{StaticResource WarningOrangeBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Target}" FontSize="13"
                                           Foreground="{StaticResource SuccessGreenBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                        Background="{StaticResource BgTertiaryBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Button Grid.Column="3" Content="🗑" FontSize="14"
                                        Background="Transparent" BorderThickness="0" Padding="8,2"
                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteEntryCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
