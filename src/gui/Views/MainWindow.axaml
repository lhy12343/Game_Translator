<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameTranslator.Gui.ViewModels"
        xmlns:v="using:GameTranslator.Gui.Views"
        x:Class="GameTranslator.Gui.Views.MainWindow"
        Title="Game Translator"
        Width="960" Height="640"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="36,*">
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Game Translator" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 拖拽区 -->
                <Border Grid.Column="1" Background="Transparent"/>
                <!-- 窗口按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Content="—" Width="36" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="OnMinimize"/>
                    <Button Content="✕" Width="36" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- 侧边导航 -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Padding="8,12">
                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Icon}" FontSize="18"
                                                       Foreground="{StaticResource AccentSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                </ListBox>
            </Border>

            <!-- 内容区 -->
            <Border Grid.Column="1" Background="{StaticResource BgPrimaryBrush}" Padding="0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}" Margin="0">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="vm:HomePageViewModel">
                                <v:HomePage/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ApiConfigPageViewModel">
                                <v:ApiConfigPage/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:TranslationPageViewModel">
                                <v:TranslationPage/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:MonitorPageViewModel">
                                <v:MonitorPage/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:GlossaryPageViewModel">
                                <v:GlossaryPage/>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
