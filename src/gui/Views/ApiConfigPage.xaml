<UserControl x:Class="GameTranslator.Gui.Views.ApiConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="32,24">
    <StackPanel Margin="0,0,0,24">

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="翻译 API 配置" FontSize="24" FontWeight="Bold" Foreground="#E8E8F0"/>
            <TextBlock Text="配置第三方翻译模型 API（密钥仅存储在本地）" FontSize="13" Foreground="#9090A8" Margin="0,4,0,0"/>
        </StackPanel>

        <Border CornerRadius="10" Background="#1A1A24" Padding="24" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="API URL" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ApiUrl}" Margin="0,0,0,16"/>
                <TextBlock Text="API Key" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ApiKey}" Margin="0,0,0,16"/>
                <TextBlock Text="模型名称" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ModelName}"/>
            </StackPanel>
        </Border>

        <Border CornerRadius="10" Background="#1A1A24" Padding="24" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="源语言" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                    <ComboBox SelectedItem="{Binding SourceLanguage}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="日语"/>
                        <ComboBoxItem Content="英语"/>
                        <ComboBoxItem Content="韩语"/>
                        <ComboBoxItem Content="自动检测"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="目标语言" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                    <ComboBox SelectedItem="{Binding TargetLanguage}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="简体中文"/>
                        <ComboBoxItem Content="繁体中文"/>
                        <ComboBoxItem Content="英语"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="连接状态" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Padding="10,8" Background="#242430">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FDCB6E" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" Foreground="#E8E8F0" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border CornerRadius="10" Background="#1A1A24" Padding="24" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="高级参数" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,0,12"/>
                <CheckBox IsChecked="{Binding UseBatchTranslation}" Content="批量翻译 (100ms 聚合窗口)" Foreground="#E8E8F0" Margin="0,0,0,12"/>
                <TextBlock Text="超时时间 (ms)" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                <Slider Value="{Binding TimeoutMs}" Minimum="1000" Maximum="30000" TickFrequency="500" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding TimeoutMs}" FontSize="12" Foreground="#A29BFE"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal">
            <Button Content="🔌 测试连接" Style="{StaticResource BtnPrimary}"/>
            <Button Content="💾 保存配置" Style="{StaticResource BtnSecondary}" Margin="12,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
