<UserControl x:Class="GameTranslator.Gui.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="32,24">
    <StackPanel Margin="0,0,0,24">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="性能监控" FontSize="24" FontWeight="Bold" Foreground="#E8E8F0"/>
            <TextBlock Text="实时监控翻译性能与系统资源" FontSize="13" Foreground="#9090A8" Margin="0,4,0,0"/>
        </StackPanel>
        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,20">
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,8" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="翻译延迟" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding TranslationLatency}" FontSize="28" FontWeight="Bold" Foreground="#FDCB6E" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,8" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="缓存命中率" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding CacheHitRate}" FontSize="28" FontWeight="Bold" Foreground="#00B894" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,0,8" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="队列长度" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding QueueLength}" FontSize="28" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,0" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="目标进程 CPU" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding CpuUsage}" FontSize="28" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,0" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="目标进程内存" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding MemoryUsage}" FontSize="28" FontWeight="Bold" Foreground="#E8E8F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="总翻译数" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding TotalTranslated}" FontSize="28" FontWeight="Bold" Foreground="#A29BFE" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border CornerRadius="10" Padding="20" Background="#1A1A24">
            <StackPanel>
                <TextBlock Text="翻译缓存目录" FontSize="11" Foreground="#9090A8"/>
                <TextBox Text="{Binding CacheDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,10"
                         Padding="10,7" Background="#111118" Foreground="#E8E8F0" BorderBrush="#303040"/>
                <DockPanel>
                    <Button Content="清除全部缓存" Command="{Binding ClearCacheCommand}" DockPanel.Dock="Right"
                            Padding="16,7" Background="#D65A5A" Foreground="White" BorderThickness="0"/>
                    <TextBlock Text="{Binding CacheStatus}" VerticalAlignment="Center" Foreground="#9090A8"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
