<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameTranslator.Gui.ViewModels"
             x:Class="GameTranslator.Gui.Views.MonitorPage"
             Padding="32,24">

    <Design.DataContext>
        <vm:MonitorPageViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="性能监控" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="实时监控翻译性能与系统资源" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 指标卡片 -->
        <UniformGrid Columns="4" Rows="2">
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,8"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="游戏 FPS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Fps, StringFormat='{}{0:F1}'}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessGreenBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,8"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Hook 延迟" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding HookLatencyMs, StringFormat='{}{0:F2}ms'}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource AccentSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,8"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="翻译延迟" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TranslationLatencyMs, StringFormat='{}{0:F0}ms'}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningOrangeBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,0,8"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="缓存命中率" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CacheHitRate, StringFormat='{}{0:F1}%'}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessGreenBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,0"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="队列长度" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding QueueLength}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,0"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="CPU 占用" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F1}%'}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20" Margin="0,0,8,0"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="内存占用" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MemoryMb, StringFormat='{}{0:F1}MB'}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="20"
                    Background="{StaticResource BgSecondaryBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="总翻译数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalTranslated}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource AccentSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 翻译日志 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="实时翻译流" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border CornerRadius="6" Background="{StaticResource BgPrimaryBrush}" Padding="12" MinHeight="120">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="[12:34:56] "/><Run Text="原文: " Foreground="{StaticResource WarningOrangeBrush}"/><Run Text="こんにちは、世界"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="[12:34:56] "/><Run Text="译文: " Foreground="{StaticResource SuccessGreenBrush}"/><Run Text="你好，世界"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="[12:34:57] "/><Run Text="缓存命中" Foreground="{StaticResource AccentSecondaryBrush}"/><Run Text=": こんにちは、世界"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
