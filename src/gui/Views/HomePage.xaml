<UserControl x:Class="GameTranslator.Gui.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="32,24">
    <StackPanel Margin="0,0,0,24">

        <!-- 标题 -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="游戏进程" FontSize="24" FontWeight="Bold" Foreground="#E8E8F0"/>
            <TextBlock Text="选择目标游戏进程并注入翻译 Hook" FontSize="13" Foreground="#9090A8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 状态卡片 -->
        <UniformGrid Columns="4" Margin="0,0,0,20">
            <Border CornerRadius="10" Padding="16" Margin="0,0,8,0" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="进程" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding SelectedProcess}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#E8E8F0" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="16" Margin="0,0,8,0" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="引擎" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding GameEngine}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#A29BFE" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="16" Margin="0,0,8,0" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="状态" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding TranslateStatus}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#00B894" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="16" Background="#1A1A24">
                <StackPanel>
                    <TextBlock Text="已翻译" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding TranslatedCount}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#E8E8F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 进程列表 -->
        <Border CornerRadius="10" Background="#1A1A24" Padding="4" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="12,8,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="进程列表" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0"/>
                    <Button Grid.Column="1" Content="🔄 刷新" Style="{StaticResource BtnGhost}"
                            Command="{Binding RefreshProcessesCommand}" FontSize="12" Padding="12,4"/>
                </Grid>
                <ListBox ItemsSource="{Binding ProcessList}"
                         SelectedItem="{Binding SelectedProcessItem}"
                         MaxHeight="180" Padding="4"/>
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="🔗 注入" Command="{Binding AttachCommand}" Style="{StaticResource BtnPrimary}"/>
            <Button Content="⏹ 断开" Command="{Binding DetachCommand}" Style="{StaticResource BtnSecondary}" Margin="12,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
