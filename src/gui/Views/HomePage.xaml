<UserControl x:Class="GameTranslator.Gui.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="32,24" AllowDrop="True"
             DragOver="OnDragOver" Drop="OnDrop">
    <StackPanel Margin="0,0,0,24">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="启动游戏翻译" FontSize="24" FontWeight="Bold" Foreground="#E8E8F0"/>
            <TextBlock Text="拖入游戏 EXE，自动写入现有 XUnity 桥接配置并启动游戏"
                       FontSize="13" Foreground="#9090A8" Margin="0,4,0,0"/>
        </StackPanel>

        <Border CornerRadius="10" Background="#1A1A24" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" Padding="28" Margin="0,0,0,20">
            <Grid>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GamePath}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="✓" FontSize="36" Foreground="#00B894" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" Margin="0,10,0,4">
                        <Run Text="已选择："/><Run Text="{Binding GameName}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding GamePath}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,0,0,14"/>
                    <Button Content="更改游戏" Click="OnBrowseGame" Style="{StaticResource BtnSecondary}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GamePath}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="将游戏 EXE 拖到这里" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="或手动选择游戏程序" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <Button Content="选择游戏 EXE" Click="OnBrowseGame" Style="{StaticResource BtnSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border CornerRadius="10" Background="#1A1A24" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" Padding="20,14" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TMP 中文字体" FontSize="13" Foreground="#9090A8"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox ItemsSource="{Binding TmpFontModes}" SelectedItem="{Binding TmpFontMode}"
                          MinWidth="240" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"
                           Text="默认使用“自动（按 Unity 版本）”；需要固定 Unity 2022 字体时选“TMP 回退字体（u2022）”。老版 TextMeshPro 游戏需选“老版 TMP 兼容”"/>
            </StackPanel>
        </Border>

        <Border CornerRadius="10" Background="#1A1A24" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="PID" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding SelectedProcessId}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#A29BFE" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="状态" FontSize="11" Foreground="#9090A8"/>
                    <TextBlock Text="{Binding MonitorStatus}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#00B894" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal">
            <Button Content="▶ 启动并翻译" Command="{Binding LaunchGameCommand}"
                    Style="{StaticResource BtnPrimary}" MinWidth="144"/>
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" Margin="14,0,0,0">
                <Run Text="本地桥接："/><Run Text="{Binding GameBridge.Status, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
