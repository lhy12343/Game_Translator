<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameTranslator.Gui.ViewModels"
             x:Class="GameTranslator.Gui.Views.ApiConfigPage"
             Padding="32,24">

    <Design.DataContext>
        <vm:ApiConfigPageViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="翻译 API 配置" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="配置第三方翻译模型 API（密钥仅存储在本地）" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- API 配置 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="API URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding ApiUrl}" Watermark="https://api.openai.com/v1/chat/completions"
                             Background="{StaticResource BgTertiaryBrush}" BorderThickness="1"
                             BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="6" Padding="10,8"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding ApiKey}" Watermark="sk-..." PasswordChar="●"
                             Background="{StaticResource BgTertiaryBrush}" BorderThickness="1"
                             BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="6" Padding="10,8"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="模型名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding ModelName}" Watermark="gpt-4o-mini"
                             Background="{StaticResource BgTertiaryBrush}" BorderThickness="1"
                             BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="6" Padding="10,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 语言设置 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <Grid ColumnDefinitions="*,*,*" Margin="0">
                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                    <TextBlock Text="源语言" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox SelectedItem="{Binding SourceLanguage}"
                              Background="{StaticResource BgTertiaryBrush}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="日语"/>
                        <ComboBoxItem Content="英语"/>
                        <ComboBoxItem Content="韩语"/>
                        <ComboBoxItem Content="自动检测"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,12,0">
                    <TextBlock Text="目标语言" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox SelectedItem="{Binding TargetLanguage}"
                              Background="{StaticResource BgTertiaryBrush}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="简体中文"/>
                        <ComboBoxItem Content="繁体中文"/>
                        <ComboBoxItem Content="英语"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="连接状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border CornerRadius="6" Padding="10,8" Background="{StaticResource BgTertiaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningOrangeBrush}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 高级参数 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="高级参数" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ToggleSwitch IsChecked="{Binding UseBatchTranslation}" Content="批量翻译 (100ms 聚合窗口)"/>
                <StackPanel Spacing="6">
                    <TextBlock Text="超时时间 (ms)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Slider Value="{Binding TimeoutMs}" Minimum="1000" Maximum="30000"
                            TickFrequency="500" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding TimeoutMs}" FontSize="12"
                               Foreground="{StaticResource AccentSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="🔌 测试连接"
                    Background="{StaticResource AccentPrimaryBrush}" Foreground="White"
                    BorderThickness="0" CornerRadius="8" Padding="24,10" FontSize="14"/>
            <Button Content="💾 保存配置"
                    Background="{StaticResource BgTertiaryBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}"
                    CornerRadius="8" Padding="24,10" FontSize="14"/>
        </StackPanel>
    </StackPanel>
</UserControl>
