<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameTranslator.Gui.ViewModels"
             x:Class="GameTranslator.Gui.Views.TranslationPage"
             Padding="32,24">

    <Design.DataContext>
        <vm:TranslationPageViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="翻译设置" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="缓存、富文本、排版自适应等高级选项" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 缓存 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="🗄 缓存" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ToggleSwitch IsChecked="{Binding EnableCache}" Content="启用 LRU 缓存"/>
                <StackPanel Spacing="6" IsVisible="{Binding EnableCache}">
                    <TextBlock Text="缓存容量 (条)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Slider Value="{Binding CacheSize}" Minimum="1000" Maximum="50000"
                            TickFrequency="1000" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding CacheSize}" FontSize="12"
                               Foreground="{StaticResource AccentSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 富文本 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="📝 富文本处理" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ToggleSwitch IsChecked="{Binding EnableRichText}"
                              Content="保留标记格式 (颜色/大小/抖动等)"/>
            </StackPanel>
        </Border>

        <!-- 排版自适应 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="📐 排版自适应" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ToggleSwitch IsChecked="{Binding EnableAutoLayout}"
                              Content="自动调整文本框宽度/换行/字号"/>
                <StackPanel Spacing="6" IsVisible="{Binding EnableAutoLayout}">
                    <TextBlock Text="最小字号缩放比例" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Slider Value="{Binding FontScaleMin}" Minimum="0.5" Maximum="1.0"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding FontScaleMin, StringFormat='{}{0:P0}'}" FontSize="12"
                               Foreground="{StaticResource AccentSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- OCR 兜底 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="🔍 OCR 兜底" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ToggleSwitch IsChecked="{Binding EnableOcr}"
                              Content="启用 OCR (无法 Hook 时自动启用)"/>
                <StackPanel Spacing="6" IsVisible="{Binding EnableOcr}">
                    <TextBlock Text="OCR 帧率 (fps)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Slider Value="{Binding OcrFps}" Minimum="5" Maximum="30"
                            TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding OcrFps}" FontSize="12"
                               Foreground="{StaticResource AccentSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 其他 -->
        <Border CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="⚙ 其他" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ToggleSwitch IsChecked="{Binding EnableOverlay}" Content="透明窗口叠加显示"/>
                <ToggleSwitch IsChecked="{Binding EnableTermConsistency}" Content="术语一致性维护"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
