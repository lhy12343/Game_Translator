<UserControl x:Class="GameTranslator.Gui.Views.GlossaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="32,24">
    <StackPanel Margin="0,0,0,24">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="术语管理" FontSize="24" FontWeight="Bold" Foreground="#E8E8F0"/>
            <TextBlock Text="维护人名、地名等术语的翻译一致性" FontSize="13" Foreground="#9090A8" Margin="0,4,0,0"/>
        </StackPanel>
        <Border CornerRadius="10" Background="#1A1A24" Padding="24" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="添加术语" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="原文" FontSize="11" Foreground="#9090A8" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewSource}" Width="160"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="译文" FontSize="11" Foreground="#9090A8" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewTarget}" Width="160"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Bottom">
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}" Width="100"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="➕ 添加" Command="{Binding AddEntryCommand}" Style="{StaticResource BtnPrimary}" VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#A29BFE" Margin="0,0,0,12"/>
        <Border CornerRadius="10" Background="#1A1A24" Padding="4">
            <StackPanel>
                <Grid Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="原文" FontSize="12" FontWeight="SemiBold" Foreground="#9090A8"/>
                    <TextBlock Grid.Column="1" Text="译文" FontSize="12" FontWeight="SemiBold" Foreground="#9090A8"/>
                    <TextBlock Grid.Column="2" Text="分类" FontSize="12" FontWeight="SemiBold" Foreground="#9090A8"/>
                    <TextBlock Grid.Column="3" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="#9090A8"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,6,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source}" FontSize="13" Foreground="#FDCB6E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Target}" FontSize="13" Foreground="#00B894" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,2" Background="#242430" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#9090A8"/>
                                </Border>
                                <Button Grid.Column="3" Content="🗑" FontSize="14" Style="{StaticResource BtnGhost}" Padding="8,2"
                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
