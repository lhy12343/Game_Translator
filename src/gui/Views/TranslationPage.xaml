<UserControl x:Class="GameTranslator.Gui.Views.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="32,24">
    <StackPanel Margin="0,0,0,24">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="真实翻译测试" FontSize="24" FontWeight="Bold" Foreground="#E8E8F0"/>
            <TextBlock Text="先在不接游戏的情况下验证 API、缓存和延迟" FontSize="13" Foreground="#9090A8" Margin="0,4,0,0"/>
        </StackPanel>

        <Border CornerRadius="10" Background="#1A1A24" Padding="24" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="原文" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                         VerticalContentAlignment="Top"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="翻译" Command="{Binding TranslateCommand}"
                    Style="{StaticResource BtnPrimary}"/>
            <Button Content="取消" Command="{Binding CancelTranslationCommand}"
                    Style="{StaticResource BtnSecondary}" Margin="12,0,0,0"/>
        </StackPanel>

        <Border CornerRadius="10" Background="#1A1A24" Padding="24" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="译文" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
                <TextBox Text="{Binding TranslatedText}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                         VerticalContentAlignment="Top"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#A29BFE" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
